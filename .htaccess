# GoShashi - Production Server Configuration (Hostinger / Apache / LiteSpeed)
Options -Indexes

# 1. Block public access to sensitive source code, environment files, and configurations
<FilesMatch "^(\.env|\.git|package\.json|package-lock\.json|tsconfig.*|server\.js|README\.md)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(ts|tsx|json|md|prisma|sql|yml|yaml|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 2. Reverse proxy all requests to the Next.js production server on port 3000
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing static files in public directory directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Route all requests to Next.js on port 3000
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
