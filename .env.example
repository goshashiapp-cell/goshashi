# Environment Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database (Hostinger MySQL 8+ in prod, local MySQL/XAMPP in dev)
DATABASE_URL="mysql://root:@localhost:3306/goshashi"

# URLs
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1" # In production: https://api.goshashi.com/api/v1

# Authentication
JWT_SECRET="goshashi-super-secret-jwt-access-key-minimum-32-chars"
JWT_REFRESH_SECRET="goshashi-super-secret-jwt-refresh-key-minimum-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Location & Maps
GOOGLE_MAPS_API_KEY="placeholder_google_maps_key"

# Email / SMTP
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="notifications@goshashi.com"
SMTP_PASSWORD="placeholder_smtp_password"

# SMS Gateway
SMS_PROVIDER="msg91"
SMS_API_KEY="placeholder_sms_key"

# WhatsApp Business API
WHATSAPP_PROVIDER="gupshup"
WHATSAPP_API_KEY="placeholder_whatsapp_key"

# File & Document Storage
STORAGE_ENDPOINT="local"
STORAGE_ACCESS_KEY="placeholder_storage_key"
STORAGE_SECRET_KEY="placeholder_storage_secret"
STORAGE_BUCKET="goshashi-documents"
